{
  "name": "wusha",
  "private": true,
  "version": "1.0.0",
  "description": "وشە | WUSHA — a Kurdish Sorani word-guessing game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
