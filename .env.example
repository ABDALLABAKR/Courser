# ---- Server ----
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# REQUIRED in production: 32+ random characters (signs admin sessions).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin dashboard password hash (never put the plain password here).
#   npm run hash-password
ADMIN_PASSWORD_HASH=

# SQLite database file (dictionary, reports, statistics).
DATABASE_PATH=./data/wene.sqlite

# Allow words that an admin has NOT approved (the demo list) to appear in games.
# Defaults to true in development and false in production. Keep false for a real launch.
# ALLOW_UNREVIEWED_WORDS=false

# Comma-separated origins allowed to connect when the frontend is hosted separately.
# Leave empty when the server also serves the frontend (same origin).
# CORS_ORIGINS=https://wene.example.com

# Set to true when running behind a reverse proxy / load balancer (uses X-Forwarded-For for rate limits).
TRUST_PROXY=false

# Serve the built frontend from this folder (default ../client/dist). Set SERVE_CLIENT=false to disable.
# CLIENT_DIST=../client/dist

# ---- Client (build time, only for separate frontend hosting) ----
# URL of the backend. Leave empty when the backend serves the frontend.
# VITE_SERVER_URL=https://api.wene.example.com
